---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { getPosts, formatDate } from '../utils/posts';
const posts = await getPosts();
---
<Base>
  <section class="intro">
    <h1>Hi, I’m Neil<span class="title-dot">.</span></h1>
    <p class="intro-copy">{site.intro}</p>
  </section>
  <section id="writing" class="writing" aria-labelledby="writing-title">
    <div class="section-heading"><h2 id="writing-title">Writing</h2></div>
    <ul class="post-list">
      {posts.map(post => <li>
        <a class="post-link" href={`/posts/${post.id}/`}>
          <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
          <div><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
          <span class="post-arrow" aria-hidden="true">↗</span>
        </a>
      </li>)}
    </ul>
    {posts.length === 0 && <p class="empty-state">Nothing published yet. A blank page is a good place to start.</p>}
  </section>
</Base>
