---
import { render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import BackToTop from '../../components/BackToTop.astro';
import { getPosts, formatDate } from '../../utils/posts';
export async function getStaticPaths() {
  return (await getPosts()).map(post => ({ params: { slug: post.id }, props: { post } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} date={post.data.publishDate} image={`/og/${post.id}.png`}>
  <article class="article">
    <a class="back-link" href="/#writing">← All writing</a>
    <header class="article-header">
      <time class="eyebrow" datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
      <h1 id="post-title" tabindex="-1">{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
    </header>
    {post.data.cover && <img class="cover" src={post.data.cover.src} alt={post.data.cover.alt} />}
    <div class="prose"><Content /></div>
    <div class="article-end"><span aria-hidden="true">∎</span><a class="back-link" href="/#writing">Back to all writing ↗</a></div>
  </article>
  <BackToTop />
</Base>
